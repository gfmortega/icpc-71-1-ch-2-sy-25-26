% problem counter ("A", "B", ...)
\newcounter{ProblemID}

% "My Title" --> "Problem X: My Title"
\newcommand\letteredtitle[1]{\problemlead{} \Alph{ProblemID}: #1}%
\newcommand\noleadletteredtitle[1]{\Alph{ProblemID}: #1}%
% "My Title" --> "Problem: My Title"
\newcommand\unletteredtitle[1]{\problemlead{}: #1}%
\newcommand\noleadunletteredtitle[1]{#1}%

% to "create a new problem", use \problem instead of \section or something
\define@key{problemkeys}{tl}{\def\probs@probtl{#1}}%
\define@key{problemkeys}{ml}{\def\probs@probml{#1}}%
\define@key{problemkeys}{standalone}[true]{
    \def\probs@probstandalone{#1}%
    \def\probs@probsectiontitle{\probs@probunletteredsectiontitle}%
    }%
\newcommand\problem[2][]{%
    % TODO fix issue with "standalone". Currently it is buggy and "standalone=false" is the same as "standalone=true".
    % Also we might want to remove the problem letter in the header if it is standalone.
    \addtocounter{ProblemID}{1}%
    \def\probs@probletteredsectiontitle{\noleadletteredtitle{#2}}%
    \def\probs@probunletteredsectiontitle{\noleadunletteredtitle{#2}}%
    \def\probs@probsectiontitle{\probs@probletteredsectiontitle}%
    \setkeys{problemkeys}{%
        tl={},%
        ml={},%
        % standalone=false,%
        #1%
    }%
    % TODO replace this with conditional based on 'standalone'
    \invisiblesection{\probs@probsectiontitle}%
    % TODO remove \Alph{ProblemID} if standalone
    \begin{center}%
        { \LARGE \problemlead{} \Alph{ProblemID}}\par%
        { \Large \bfseries #2 }\par%
        \expandafter\ifblank\expandafter{\probs@probtl}{}{ { \large Time Limit: \probs@probtl }\par }%
        \expandafter\ifblank\expandafter{\probs@probml}{}{ { \large Memory Limit: \probs@probml } }%
    \end{center}%
}%

% use this in case the title is too long for the footer: \problemshortmark{abbreviated title}
\newcommand\problemshortmark[1]{\markboth{\noleadletteredtitle{#1}}{}}%

% custom verbatim environment for I/O
\newenvironment{IObox}%
    {\vspace*{-6pt}\VerbatimEnvironment\begin{BVerbatim}[baseline=t]}%
    {\end{BVerbatim}\vspace*{6pt}}%

\newcommand\IOboxInput[1]{\vspace*{-6pt}\BVerbatimInput[baseline=t]{#1}\vspace*{6pt}}%

% sample I/O with two extra arguments denoting the relative sizes of I and O.
\newlength{\customblocktotal}
\newlength{\customblockoff}
\setlength{\customblocktotal}{5.58in}
\setlength{\customblockoff}{0.082in}

\newlength{\probs@sampi}
\newlength{\probs@sampo}
\define@key{sampleIOkeys}{f}{%
    \def\probs@sampfile{#1}%
    \def\probs@sampifile{#1.in}%
    \def\probs@sampofile{#1.ans}%
    }%
\define@key{sampleIOkeys}{n}{\def\probs@sampidx{#1}}%
\define@key{sampleIOkeys}{i}{\def\probs@sampinput{#1}}%
\define@key{sampleIOkeys}{o}{\def\probs@sampoutput{#1}}%
\define@key{sampleIOkeys}{iweight}{\def\probs@sampiweight{#1}}%
\define@key{sampleIOkeys}{oweight}{\def\probs@sampoweight{#1}}%
\newcommand\sampleIBox{\IOboxInput{\probs@sampifile}}%
\newcommand\sampleOBox{\IOboxInput{\probs@sampofile}}%
\newenvironment{sampleIO}[1][]{
    \setkeys{sampleIOkeys}{%
        n={},%
        f={},%
        i={Input},%
        o={Output},%
        iweight=1,%
        oweight=1,%
        #1%
    }%
    
    \setlength{\probs@sampi}{(\customblocktotal - 2\customblockoff) * \probs@sampiweight / (\probs@sampiweight + \probs@sampoweight)}
    \setlength{\probs@sampo}{\customblocktotal - 2\customblockoff - \probs@sampi}
    \small
    \vspace*{0.1in}
    \begin{center}
        \begin{tabular}{|p{\probs@sampi}|p{\probs@sampo}|}
        \arrayrulecolor{\contestboxbgcolor}
        \hline
        \rowcolor{\contestboxbgcolor}
        \thead[cl]{{\color{\contestboxtextcolor}\probs@sampinput{} \probs@sampidx{}}}     &
        \thead[cl]{{\color{\contestboxtextcolor}\probs@sampoutput{} \probs@sampidx{}}}
        \arrayrulecolor{\contestboxbgcolor}
        \\ \hline
}{
        \arrayrulecolor{\contestboxbgcolor}
        \\ \hline
        \end{tabular}
    \end{center}
    \normalsize
}%

% block version for sample I/O that's "long", i.e., stretches across the line.
% Create two, one for I and one for O.
\newenvironment{sampleIOblock}[1]{
    \small
    \vspace*{0.1in}
    \begin{center}
    \begin{tabular}{|p{\customblocktotal}|}
    \arrayrulecolor{\contestboxbgcolor}
    \hline
    \rowcolor{\contestboxbgcolor}
    \thead[cl]{{\color{\contestboxtextcolor}#1}}
    \arrayrulecolor{\contestboxbgcolor}
    \\ \hline
}{
    \arrayrulecolor{\contestboxbgcolor}
    \\ \hline
    \end{tabular}
    \end{center}
    \normalsize
}%


% table of constraints valid for all subtasks.
\newcommand\constraints[1]{
    \constraintsB{Constraints}{#1}
}%

\newcommand\constraintsB[2]{
    \small
    \vspace*{0.1in}
    \begin{center}
    \begin{tabular}{|p{\customblocktotal}|}
    \arrayrulecolor{\contestboxbgcolor}
    \hline
    \rowcolor{\contestboxbgcolor}
    \thead[cl]{{\color{\contestboxtextcolor}#1}}
    \arrayrulecolor{\contestboxbgcolor}
    \\ \hline
    \makecell[tl]{#2}
    \arrayrulecolor{\contestboxbgcolor}
    \\ \hline
    \end{tabular}
    \end{center}
    \normalsize
}%

% table of subtask constraints and points
\renewcommand\theadfont{\small\bfseries}
\renewcommand\cellgape{\Gape[3pt]}
\newlength{\subtaskid}
\newlength{\subtaskpoints}
\newlength{\subtaskconstraints}
\setlength{\subtaskid}{0.61in}
\setlength{\subtaskpoints}{0.49in}
\setlength{\subtaskconstraints}{\customblocktotal - 4\customblockoff - \subtaskid - \subtaskpoints}
\newenvironment{subtasks}{
    \small
    \vspace*{0.12in}
    \begin{center}
    \begin{tabular}{|p{\subtaskid}p{\subtaskpoints}p{\subtaskconstraints}|}
    \arrayrulecolor{\contestboxbgcolor}
    \hline
    \rowcolor{\contestboxbgcolor}
    \thead[cc]{{\color{\contestboxtextcolor}Subtask}} & \thead[cc]{{\color{\contestboxtextcolor}Points}} & \thead[cl]{{\color{\contestboxtextcolor}Constraints}}  
    \arrayrulecolor{\contestboxbgcolor}
    \\ \hline
}{
    \end{tabular}
    \end{center}
    \normalsize
}%

% a single subtask inside the subtasks environment
\newcommand\subtask[3]{
    \makecell[tc]{#1} &
    \makecell[tc]{\bfseries #2} &
    \makecell[tl]{#3}
    \arrayrulecolor{\contestboxbgcolor}
    \\ \hline
}%

